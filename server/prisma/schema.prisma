generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id Int @id @default(autoincrement())

  name String

  // Company profile / branding — surfaced via GET/PUT /company/settings and
  // used downstream for email templates, PDFs, quotes, and invoices.
  logoUrl      String?
  billingEmail String?
  contactEmail String?
  phone        String?
  website      String?
  address      String?
  taxNumber    String?
  vatNumber    String?

  // C1.1 — extended profile fields. All optional/additive; existing rows
  // default to null (blank) with no backfill required.
  legalName          String?
  registrationNumber String?
  postalCode         String?
  city               String?
  country            String?

  // C1.3 — branding colors. Hex strings ("#rrggbb"), validated server-side
  // in services/companyValidation.ts. logoUrl (above) is the third branding
  // input; centralized consumption is documented in docs/company-management.md.
  primaryColor String?
  accentColor  String?

  // C1.4 — localization preferences. `language`/`currency` are DISPLAY
  // defaults for this company only — they do NOT affect the S2.1-S2.3
  // subscription/checkout currency, which stays governed by the website
  // language at checkout time (never touched by this module).
  language   String?
  currency   String?
  timezone   String?
  dateFormat String?
  timeFormat String?

  // C1.5 — preferences. `firstDayOfWeek`: 0=Sunday..6=Saturday (ISO-ish,
  // matches JS Date#getDay()). Working-hours/shift-length are "HH:mm" /
  // minutes, validated server-side.
  firstDayOfWeek             Int?
  defaultWorkStart           String?
  defaultWorkEnd             String?
  defaultShiftMinutes        Int?
  notificationsEnabled       Boolean @default(true)
  emailNotificationsEnabled  Boolean @default(true)
  desktopNotificationsEnabled Boolean @default(true)

  // Subscription / billing — Stripe Checkout + webhook keep these in sync.
  plan                 String    @default("free")
  subscriptionStatus   String    @default("inactive")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionEndsAt   DateTime?

  // S2.6 upgrade/downgrade engine — both maintained exclusively by the
  // Stripe sync layer (services/stripe/syncSubscription.ts) and the plan
  // change service. `cancelAtPeriodEnd` mirrors Stripe's flag of the same
  // name; `pendingPlan` holds the canonical plan a scheduled (period-end)
  // downgrade will land on, null when no downgrade is pending.
  cancelAtPeriodEnd Boolean @default(false)
  pendingPlan       String?

  // Design C (docs/checkout-only-upgrades-ux.md) — when this company consumed
  // its one-and-only Starter trial. Set at registration (the trial starts
  // there); once set, Checkout never grants trial_period_days to this company
  // again. Backfilled to createdAt for every pre-existing company: each of
  // them registered through the trial-granting path, and business rule 4 says
  // no company gets a second trial.
  trialConsumedAt DateTime?

  // Soft-delete / archive — set together either when the owning
  // BUSINESS_OWNER deletes their account (account.routes.ts) or explicitly
  // archives the company (C1.7, companyArchive.routes.ts). Both paths reuse
  // the SAME flag: auth.middleware.ts already refuses login for any user
  // whose company is inactive, which is exactly Archive's "disable login for
  // company users" requirement — no separate archive mechanism needed.
  // Existing rows/relations (including Stripe fields and invoices) are kept
  // for history; nothing is ever physically removed.
  active    Boolean   @default(true)
  deletedAt DateTime?

  employees   Employee[]
  customers   Customer[]
  projects    Project[]
  users       User[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  ownerNotes  OwnerNote[]

  // N1.1 — Notification & Email module (docs/notification-system-plan.md).
  notificationEvents      NotificationEvent[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  notificationPreferences NotificationPreference[]
  emailSuppressions       EmailSuppression[]

  // Phase 3 — Owner Command Center conversion targets.
  tasks               Task[]
  reminders           Reminder[]
  communicationLogs   CommunicationLog[]
  projectInternalNotes ProjectInternalNote[]
  ownerNoteConversions OwnerNoteConversion[]

  // CAL1.1 — Calendar module (docs/calendar-system-plan.md). Back-relations
  // only: Prisma requires every relation to be declared on both sides, and
  // these navigation fields generate NO SQL column. Same as the N1.1 block
  // above — "0 existing tables modified" is a statement about the DATABASE,
  // and it holds (scope §7.1).
  calendars       Calendar[]
  calendarMembers CalendarMember[]
  calendarEvents  CalendarEvent[]
  calendarAudits  CalendarAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The Stripe webhook resolves a company by customer id whenever the event
  // metadata carries no companyId (stripeWebhook.routes.ts resolveCompanyId).
  // Not @unique: that would be a CONSTRAINT, which could fail on existing data
  // and change behaviour — indexes here are additive only.
  @@index([stripeCustomerId])
}

// Design C — webhook idempotency ledger. One row per successfully handled
// Stripe event id; the webhook skips events it has already processed, so a
// redelivery can never double-apply a state write or re-send the
// subscription-confirmed email. Absolute state writes make duplicates mostly
// harmless anyway — this makes them entirely harmless.
model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model User {
  id Int @id @default(autoincrement())

  email    String @unique
  password String
  role     String @default("BUSINESS_OWNER")

  emailVerified               Boolean   @default(false)
  emailVerificationToken      String?   @unique
  emailVerificationExpiresAt  DateTime?

  passwordResetToken      String?   @unique
  passwordResetExpiresAt  DateTime?

  // Set on every successful login (see auth.routes.ts). Drives the admin
  // analytics dashboard's Active Users / Last Login / status columns; null
  // means the account has never signed in.
  lastLoginAt DateTime?

  // N1.1 (Q6) — the user's own notification language ("hu" | "en"), null =
  // inherit. Resolution order for any backend-generated message:
  // User.language → Company.language → "en". A per-user column (rather than
  // relying on Company.language alone) is deliberate: a mixed-language team
  // is normal, and the company-wide default would be wrong for half of them.
  // Unlike Company.language (a C1.4 DISPLAY preference the server never
  // reads), this one is read by the notification module.
  language String?

  // Session invalidation (K2.1.2) — every issued JWT carries the value
  // current at sign-in; the auth middleware rejects tokens whose claim no
  // longer matches. Incrementing this field therefore kills every
  // outstanding session at once (password reset, account deletion, future
  // forced/manual logout).
  tokenVersion Int @default(0)

  // Soft-delete — login is rejected once `active` is false. Set by
  // POST /account/delete; nothing is physically removed.
  active    Boolean   @default(true)
  deletedAt DateTime?

  // Optional: a DEVELOPER (platform operator) belongs to no company.
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  // Set only for EMPLOYEE-role users — links the login to the worker record
  // that owns their shifts/projects.
  employeeId Int?     @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  projectNotes         ProjectNote[]
  projectAttachments   ProjectAttachment[]
  projectActivities    ProjectActivity[]
  ownerNotes           OwnerNote[]
  projectInternalNotes ProjectInternalNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Employee {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  phone     String?
  email     String?

  status String @default("Active")

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  assignments ProjectAssignment[]
  user        User?
  ownerNotes  OwnerNote[]
  tasks       Task[]

  // CAL1.1 — back-relations only, no SQL column (see Company).
  calendars            Calendar[]
  calendarEvents       CalendarEvent[]
  calendarParticipants CalendarParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Shift     Shift[]

  // Roadmap #3, prescribed index. Serves the owner dashboard's
  // `employee.count({ ...scope, status: "Active" })` (dashboard.routes.ts),
  // and its leftmost prefix also covers every plain `where: { companyId }`
  // employee lookup, so no separate companyId index is needed.
  @@index([companyId, status])
}

model Project {
  id Int @id @default(autoincrement())

  name        String
  description String?
  status      String    @default("Planned")
  deadline    DateTime?

  // Geofence foundation (V1) — location data only, no automatic clock
  // in/out is wired up to this yet.
  address          String?
  latitude         Float?
  longitude        Float?
  geofenceRadius   Float?
  geofenceEnabled  Boolean @default(false)

  customerId Int?

  customer Customer? @relation(fields: [customerId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  assignments ProjectAssignment[]
  notes       ProjectNote[]
  attachments ProjectAttachment[]
  activities  ProjectActivity[]
  ownerNotes  OwnerNote[]

  // Phase 3 — Owner Command Center conversion targets.
  tasks             Task[]
  reminders         Reminder[]
  communicationLogs CommunicationLog[]
  internalNotes     ProjectInternalNote[]

  // CAL1.1 — back-relations only, no SQL column (see Company).
  calendars      Calendar[]
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Shift     Shift[]

  // Roadmap #3, prescribed index — `project.count({ ...scope, status: "Active" })`
  // on the owner dashboard; the companyId prefix also serves the plain
  // tenant-scoped project list.
  @@index([companyId, status])
  @@index([customerId])
}

model ProjectNote {
  id Int @id @default(autoincrement())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  content String

  createdAt DateTime @default(now())

  // Loaded as a project's note list, and scanned by the FK check when a
  // project (or the authoring user) is deleted.
  @@index([projectId])
  @@index([userId])
}

model ProjectAttachment {
  id Int @id @default(autoincrement())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  fileName String
  fileType String
  fileSize Int
  fileUrl  String

  // Free-form on purpose (not a Prisma enum) so adding a category later is
  // a data change, not a migration. Validated against a fixed list at the
  // API layer (see constants/attachmentCategories.ts) — defaults to
  // "Other" for both new uploads without a category and existing rows.
  category String @default("Other")

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

// Free-form, append-only feed of everything that happens on a project — the
// "what happened, when, who did it" timeline shown in Project Details.
// `metadata` is a free-form JSON string (same approach as AuditLog) since
// each `type` carries different shape (e.g. FILE_UPLOADED carries a file
// name, CLOCK_OUT carries nothing extra).
model ProjectActivity {
  id Int @id @default(autoincrement())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  type     String
  metadata String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

model ProjectAssignment {
  id Int @id @default(autoincrement())

  employeeId Int
  projectId  Int

  employee Employee @relation(fields: [employeeId], references: [id])

  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())

  // The existing @@unique already indexes (employeeId, projectId), which
  // covers employee-side lookups via its leftmost prefix. The reverse
  // direction — "who is assigned to this project" — has no index.
  @@unique([employeeId, projectId])
  @@index([projectId])
}

model Customer {
  id Int @id @default(autoincrement())

  name    String
  email   String?
  phone   String?
  address String?

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  projects   Project[]
  ownerNotes OwnerNote[]

  // Phase 3 — Owner Command Center conversion targets.
  reminders         Reminder[]
  communicationLogs CommunicationLog[]

  // CAL1.1 — back-relation only, no SQL column (see Company).
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Shift {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  start DateTime
  end   DateTime?

  notes String?

  // CAL1.1 — back-relation only, no SQL column (see Company). An event may
  // POINT AT a shift; it never copies the shift's start/end/notes (R5).
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Roadmap #3, prescribed index. Exactly the shape of GET /shifts/me:
  // `where: { employeeId }, orderBy: { start: "desc" }` (shifts.routes.ts).
  // The employeeId prefix also covers the open-shift lookup used by
  // clock-in/clock-out.
  @@index([employeeId, start])
  @@index([projectId])
}

// Owner Command Center — a private, owner-only scratchpad for quick notes
// and reminders, optionally linked to a Project/Customer for context.
// Deliberately separate from ProjectNote (which is project-scoped and
// visible to assigned employees too); these are owner/developer-only.
model OwnerNote {
  id Int @id @default(autoincrement())

  title   String
  content String

  // "Inbox" | "Reviewed" | "ReadyToConvert" | "Archived" — see
  // constants/ownerNoteStatuses.ts. Free-form on purpose, same rationale as
  // ProjectAttachment.category.
  status String @default("Inbox")

  // Phase 3 — "Low" | "Medium" | "High" | "Urgent", see constants/priorities.ts.
  // Free-form for the same reason as `status`. Transfers to Task/Reminder
  // when a note is converted.
  priority String @default("Medium")

  // Phase 3 — pinned notes always sort first, ignoring normal ordering.
  pinned Boolean @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Phase 2 — owner can also link the note to the employee it's about
  // (e.g. "Peter should go on Friday"). Detection only ever suggests this;
  // linking always requires an explicit owner action.
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // Phase 3 — every conversion this note has produced (Task, Reminder,
  // CommunicationLog, ProjectInternalNote). Used for duplicate-protection
  // ("already converted") display and audit history.
  conversions OwnerNoteConversion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Roadmap #3, prescribed index — the Command Center dashboard runs three
  // `ownerNote.count({ companyId, status })` queries per load
  // (ownerNotes.routes.ts), and the list endpoint filters by status too. The
  // companyId prefix covers the unfiltered tenant list.
  @@index([companyId, status])
  @@index([userId])
  @@index([projectId])
  @@index([customerId])
  @@index([employeeId])
}

// Phase 3 — minimum Task architecture needed for Owner Command Center
// conversions. Deliberately not a full task-management module (no
// checklists, no templates, no sub-tasks) — see OwnerNote conversion flow
// in ownerNotes.routes.ts. Designed to be extended later without breaking
// this shape.
model Task {
  id Int @id @default(autoincrement())

  title       String
  description String?

  // "Open" | "InProgress" | "Done" — see constants/taskStatuses.ts.
  status String @default("Open")

  // "Low" | "Medium" | "High" | "Urgent" — see constants/priorities.ts.
  priority String @default("Medium")

  dueDate DateTime?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([employeeId])
}

// Phase 3 — Owner Note → Reminder conversion target. Notification delivery
// (push/PWA) is a future extension point; this only stores the reminder
// itself.
model Reminder {
  id Int @id @default(autoincrement())

  title   String
  dueDate DateTime?

  // "Low" | "Medium" | "High" | "Urgent" — see constants/priorities.ts.
  priority String @default("Medium")

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([customerId])
}

// Phase 3 — Owner Note → Communication Log conversion target. Records a
// customer interaction (call/email/meeting) the owner logged from a note.
model CommunicationLog {
  id Int @id @default(autoincrement())

  // "PhoneCall" | "Email" | "Meeting" | "Other" — see
  // constants/communicationTypes.ts.
  type    String @default("Other")
  content String

  occurredAt DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([customerId])
  @@index([projectId])
}

// Phase 3 — Owner Note → Project Internal Note conversion target.
// Deliberately separate from ProjectNote: ProjectNote is visible to
// assigned employees, this is owner/developer-only (same visibility rule
// as OwnerNote itself).
model ProjectInternalNote {
  id Int @id @default(autoincrement())

  content String

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([projectId])
  @@index([userId])
}

// Phase 3 — audit trail of every conversion an OwnerNote has produced.
// `targetType` + `targetId` point at the created Task/Reminder/
// CommunicationLog/ProjectInternalNote row. Drives duplicate-protection
// ("already converted") checks and the conversion history view.
model OwnerNoteConversion {
  id Int @id @default(autoincrement())

  ownerNoteId Int
  ownerNote   OwnerNote @relation(fields: [ownerNoteId], references: [id])

  // "Task" | "Reminder" | "CommunicationLog" | "ProjectInternalNote"
  targetType String
  targetId   Int

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  // The duplicate-protection check queries `{ ownerNoteId, companyId }`
  // (ownerNotes.routes.ts) before every conversion.
  @@index([ownerNoteId, companyId])
  @@index([companyId])
}

model AuditLog {
  id Int @id @default(autoincrement())

  action String

  userId    Int?
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  // Free-form JSON string — kept simple (no separate key/value table) since
  // this is a fixed-shape audit trail, not a queryable analytics store.
  metadata String?

  createdAt DateTime @default(now())

  @@index([companyId])
}

model Invitation {
  id Int @id @default(autoincrement())

  email String
  token String @unique
  role  String @default("EMPLOYEE")

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  invitedByUserId Int

  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Notification & Email module (N1.1) — see docs/notification-system-plan.md
//
// Six models, all additive. Nothing reads or writes them yet; N1.5 wires the
// pipeline. Layering (deliberately three tables, not one):
//   NotificationEvent    WHAT happened, and did we intend to tell anyone?
//   NotificationDelivery WHO on WHICH channel, with WHAT outcome — and if it
//                        never went out, WHY not (the support question).
//   EmailEvent           what the PROVIDER said afterwards.
// The type catalog and the templates live in code (constants/ + emails/), not
// in tables: the repo's stated rule is that adding a capability is a registry
// append, never a migration (see constants/features.ts).
// ---------------------------------------------------------------------------

// The outbox and the event log in one. Written INSIDE the same Prisma
// transaction as the domain change it describes, so a crash can never leave a
// committed state change without its notification (the official pg-boss
// Prisma adapter needs Prisma 7; this pattern keeps us on 6 — plan §9.2).
model NotificationEvent {
  id Int @id @default(autoincrement())

  // Registry key, e.g. "billing.trial_ending" — validated against
  // constants/notifications.ts, free-form here on purpose (same reasoning as
  // every other status/type column in this schema).
  type String

  // Optional: platform operators (DEVELOPER) belong to no company, and the
  // auth notifications they receive — password reset above all — are about a
  // USER, not a tenant. A required column here would have broken that flow.
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  // THE idempotency backbone (plan §3.4). Format: <type>/<scope>/<discriminator>.
  // A daily trial-reminder sweep can therefore run any number of times and
  // still produce exactly one notification per company per threshold — this
  // unique index IS the "last reminder sent" marker the UX spec asked for, with
  // no extra column. Nullable: some events (password reset) are deliberately
  // repeatable.
  dedupeKey String? @unique

  // Template variables, JSON string (same convention as AuditLog.metadata and
  // ProjectActivity.metadata — never the Json column type).
  context String?

  // Who triggered it. A plain scalar, NOT a relation: it must survive the
  // user's deletion, exactly like AuditLog.userId.
  actorUserId Int?

  // "pending" → "fanned_out" | "failed" (NOTIFICATION_EVENT_STATUSES).
  status      String    @default("pending")
  processedAt DateTime?

  deliveries    NotificationDelivery[]
  notifications Notification[]

  createdAt DateTime @default(now())

  // The outbox drainer's query: oldest pending first.
  @@index([status, createdAt])
  // Admin/support: a company's event history.
  @@index([companyId, createdAt])
}

// One in-app notification for one user — the bell feed. Stored rather than
// derived from subscription state: read/unread has nowhere else to live, and
// one-shot events (e.g. "downgrade scheduled") cannot be reconstructed from
// current state at all. Title/body are stored ALREADY RENDERED in the
// recipient's language, so the feed needs no template engine at read time.
model Notification {
  id Int @id @default(autoincrement())

  eventId Int
  event   NotificationEvent @relation(fields: [eventId], references: [id])

  // Nullable for the same reason as NotificationEvent.companyId.
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  // Scalar, not a relation — same rationale as AuditLog.userId.
  userId Int

  type     String
  severity String @default("info")

  title String
  body  String

  // Exactly one primary CTA per item (the UX spec's rule); both null when the
  // notification is purely informational.
  ctaLabel String?
  ctaPath  String?

  readAt DateTime?

  createdAt DateTime @default(now())

  // N1.7.3 — one event produces at most ONE bell item per user, enforced by
  // the database rather than by timing.
  //
  // deliverInApp claims its attempt with a compare-and-set on `attempts`, but
  // that is a ticket, not a lease: the row stays `pending` for the whole of the
  // render and insert, so a second caller reading inside that window sees the
  // incremented value, its own compare-and-set succeeds, and both reach
  // notification.create. Reachable when two sweep runs overlap (the sweep is
  // cron'd every minute and works through batches of 100). The email channel
  // survives the same interleaving because Resend deduplicates on the
  // per-delivery idempotency key; in-app had no equivalent backstop, so the
  // user simply saw the notification twice.
  //
  // A constraint rather than a longer lock: it makes the duplicate impossible
  // under ANY interleaving, including ones nobody has thought of, and it is the
  // same idiom the module already uses for idempotency (NotificationEvent
  // .dedupeKey, EmailEvent's provider-id primary key). Safe as a constraint
  // because this table is new and empty in production — the repo's "indexes are
  // additive, never constraints" rule protects EXISTING data.
  @@unique([eventId, userId])
  // The unread badge count, and the feed itself.
  @@index([userId, readAt])
  @@index([companyId, createdAt])
}

// One row per (event × recipient × channel). This is the delivery ledger: it
// records the attempt even when nothing was sent, because "why did my customer
// not get the email?" is the expensive support question and suppressionReason
// answers it directly.
model NotificationDelivery {
  id Int @id @default(autoincrement())

  eventId Int
  event   NotificationEvent @relation(fields: [eventId], references: [id])

  // Nullable for the same reason as NotificationEvent.companyId.
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  // NOTIFICATION_CHANNELS: "EMAIL" | "IN_APP" | "PUSH" | "SMS".
  channel String

  recipientUserId Int?
  // Email address / phone / device token. Full value here (support needs it);
  // logs mask it via utils/maskEmail.ts.
  recipientAddress String
  // The locale this was actually rendered in — not re-derived later.
  locale String

  // DELIVERY_STATUSES: pending → sent → delivered | bounced | complained
  //                    | failed (retries exhausted) | suppressed (never sent).
  status String @default("pending")
  // Only when status = "suppressed": which gate stopped it
  // (DELIVERY_SUPPRESSION_REASONS).
  suppressionReason String?

  // Resend's message id — the join key for provider webhooks (N1.6).
  providerMessageId String?

  attempts  Int     @default(0)
  lastError String?

  sentAt      DateTime?
  deliveredAt DateTime?

  events EmailEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Provider webhook lookup by message id.
  @@index([providerMessageId])
  // Support/admin filtering, and the monitoring queries.
  @@index([companyId, status, createdAt])
  @@index([status])
}

// Raw provider (Resend) delivery events. The PK is the provider's own event id
// — the same trick ProcessedStripeEvent uses: re-delivery of an event we have
// already stored is a primary-key collision, i.e. replay protection for free.
model EmailEvent {
  id String @id

  // Resolved from providerMessageId; null when the event arrives for a message
  // we have no delivery row for (should not happen, but must not throw).
  deliveryId Int?
  delivery   NotificationDelivery? @relation(fields: [deliveryId], references: [id])

  // "email.delivered" | "email.bounced" | "email.complained" | … Resend ships
  // 19 event types; note that "email.sent" means the API call succeeded, NOT
  // that the message was delivered — never surface it as "delivered".
  type String

  // Full webhook payload, JSON string.
  payload String?

  occurredAt DateTime
  receivedAt DateTime @default(now())

  @@index([deliveryId])
  @@index([type, occurredAt])
}

// Per-category, per-channel switch. Three levels resolve in order:
//   user row (userId set) → company default (userId null) → registry default.
// Mandatory categories (security, critical billing) ignore all three — that is
// a registry property, not something a row here can override.
model NotificationPreference {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  // null = the company-wide default for this category+channel.
  userId Int?

  category String
  channel  String
  enabled  Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per scope. Safe as a constraint because the table is new — the
  // "indexes are additive, never constraints" rule protects EXISTING data.
  @@unique([companyId, userId, category, channel])
  @@index([companyId])
}

// Addresses we must not email again: hard bounces and spam complaints, fed by
// the provider webhooks (N1.6). Checked before every send — a global gate that
// sits in front of every preference check, because sending to a complained
// address damages the whole domain's reputation, not just one tenant's.
model EmailSuppression {
  id Int @id @default(autoincrement())

  email String @unique

  // SUPPRESSION_REASONS: "bounced" | "complained" | "manual".
  reason String

  // Which tenant's send triggered it (diagnostics only — the block itself is
  // global).
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  // Free-form JSON string: the provider payload that caused the entry.
  detail String?

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Calendar module (CAL1.1) — see docs/calendar-system-plan.md and
// docs/calendar-cal1-scope.md
//
// Nine models, all additive, ZERO existing columns changed. Nothing reads or
// writes any of them yet: the permission layer is CAL1.3, the first endpoints
// are CAL1.4/CAL1.5. Five of the nine (Participant, Attachment, Comment,
// Reminder, Audit) stay empty until CAL2.x — shipped now, like N1.1's six
// tables, because one schema review is cheaper than two and an empty table
// carries no risk.
//
// The shape rests on two decisions worth restating where the columns live:
//
//   D1  ONE event table plus ONE container. The four calendar types
//       (PERSONAL/COMPANY/PROJECT/EMPLOYEE) are a property of the container,
//       not four data shapes — permission attaches to the container, so
//       "Peter can see the Kovacs project calendar" is one row, not one row
//       per event.
//
//   R5  Events REFERENCE their source objects and never copy them. projectId,
//       customerId, employeeId and shiftId are relations; there is deliberately
//       no customerName, no projectAddress, no shiftStart column. A copied
//       customer address goes stale and sends a technician to the wrong
//       street; a reference cannot. Enforced in review — the schema can only
//       make it easy, not mandatory (plan §6.5).
//
// Convention notes that apply to every model below: Int autoincrement PKs, no
// Prisma enums (string + constants/calendar*.ts), JSON as String? not the Json
// column type, append-only models carry no updatedAt, and anything that must
// outlive a user's deletion is a SCALAR id, not a relation.
// ---------------------------------------------------------------------------

// The container. What a calendar IS, who owns it, and — via CalendarMember —
// who may look at it.
model Calendar {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  // CALENDAR_TYPES: PERSONAL | COMPANY | PROJECT | EMPLOYEE.
  type String

  name        String
  description String?

  // Hex "#rrggbb", reusing the Company.primaryColor validator.
  color String?

  // IANA name. NULL = inherit Company.timezone, then the single fallback
  // stated in services/calendar/timezone.ts (CAL1.2).
  timezone String?

  // Scalar, NOT a relation — the calendar must outlive its owner's account
  // deletion, exactly like AuditLog.userId.
  ownerUserId Int?

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // KNOWN LIMIT (scope §2, CAL1.1): "one default calendar per user" is NOT
  // expressible here — it needs a partial unique index (WHERE isDefault), which
  // Prisma cannot declare. Same limitation N1.1 documented for
  // NotificationPreference's NULL userId. Consequence: CAL1.4 creates
  // calendars find-then-create, never with a bare create(), and a test pins it.
  isDefault Boolean @default(false)

  // Soft-delete. DELETE /calendars/:id sets this; the row is never removed,
  // because its audit trail and events must remain readable.
  archivedAt DateTime?

  members CalendarMember[]
  events  CalendarEvent[]
  audits  CalendarAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, type])
  @@index([ownerUserId])
  @@index([projectId])
  @@index([employeeId])
}

// One permission grant: "this principal has this preset on this calendar".
// The whole sharing model is rows in this table — there is no shareLevel column
// anywhere, on purpose (plan §4.8): a denormalised level could drift from the
// grants and the system would hold two answers to "who can see this?".
model CalendarMember {
  id Int @id @default(autoincrement())

  calendarId Int
  calendar   Calendar @relation(fields: [calendarId], references: [id])

  // Denormalised so "which calendars does this user see?" — the first query of
  // every calendar read — resolves without a join.
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  // PRINCIPAL_TYPES: USER | EMPLOYEE | ROLE | COMPANY.
  principalType String

  // STRING, not Int: a ROLE grant's principal is the role NAME ("EMPLOYEE"),
  // not a number. This is the only reason the column is not an Int.
  principalId String

  // CALENDAR_ROLE_PRESETS (CAL1.3): OWNER | ADMIN | MANAGER | MEMBER | VIEWER
  // | FREE_BUSY | CUSTOM. Presets expand to permissions at resolution time, so
  // widening a preset later upgrades every existing grant automatically.
  preset String

  // JSON string, and ONLY meaningful when preset = "CUSTOM".
  permissions String?

  // Scalar — who granted it. Survives that user's deletion.
  grantedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One principal gets exactly one grant per calendar. Safe as a constraint:
  // the table is new and empty, so the repo's "indexes are additive, never
  // constraints" rule — which protects EXISTING data — does not apply.
  @@unique([calendarId, principalType, principalId])
  @@index([companyId, principalType, principalId])
}

// The event itself.
model CalendarEvent {
  id Int @id @default(autoincrement())

  // Required: this is what decides who may read the event.
  calendarId Int
  calendar   Calendar @relation(fields: [calendarId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  title       String
  description String?

  // Stored UTC. Unlike Shift.end, endsAt is NOT nullable — an open-ended
  // calendar entry has no meaning, and every window query depends on it.
  startsAt DateTime
  endsAt   DateTime

  // All-day is a flag, never 00:00–23:59 UTC: the boundaries are resolved in
  // the calendar's zone, or a Hungarian all-day event spans two days for a
  // client reading in UTC (plan §5.1).
  allDay Boolean @default(false)

  // NULL = inherit the calendar's zone.
  timezone String?

  // RFC 5545 rule, e.g. "FREQ=WEEKLY;BYDAY=MO,WE;UNTIL=20261231T230000Z".
  // Occurrences are expanded at read time, never materialised — "every Monday,
  // forever" has no row count (D4).
  recurrenceRule String?

  // The pruning column that makes the window query possible: the last
  // occurrence's end, computed at WRITE time. NULL = the rule is infinite.
  // Without it, answering "what is in March?" would mean expanding every
  // recurring rule in the tenant just to find out which ones reach the window.
  recurrenceEndsAt DateTime?

  // EVENT_STATUSES / EVENT_VISIBILITIES — constants/calendarEvents.ts.
  status     String @default("confirmed")
  visibility String @default("default")

  // Scalar — survives the creator's account deletion.
  createdByUserId Int

  // R5: references, never copies. See the module header.
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id])

  // An OVERRIDE, not a copy: filled in only when the event genuinely happens
  // somewhere other than its project/customer address. Left NULL, the address
  // resolves from the reference at read time and automatically follows the
  // project when it moves (resolveEventLocation, plan §6.5).
  location  String?
  latitude  Float?
  longitude Float?

  // JSON string (convention — never the Json column type).
  metadata String?

  occurrences  CalendarEventOccurrence[]
  participants CalendarParticipant[]
  attachments  CalendarEventAttachment[]
  comments     CalendarEventComment[]
  reminders    CalendarEventReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The main window query.
  @@index([calendarId, startsAt])
  // Company-wide timeline.
  @@index([companyId, startsAt])
  // Source filtering, and the FK scans when a referenced row is deleted.
  @@index([projectId])
  @@index([customerId])
  @@index([employeeId])
  @@index([shiftId])
  // Recurring-candidate pruning (see recurrenceEndsAt).
  @@index([recurrenceEndsAt])
}

// Exceptions to a recurrence rule — and ONLY the exceptions. "This one is
// cancelled" or "this one moved"; every other occurrence has no row at all and
// is computed from the rule.
//
// No companyId: this is a child of CalendarEvent, so the tenant is reachable
// through the parent. Same reasoning as EmailEvent under NotificationDelivery —
// denormalising here would only add a way for child and parent to disagree,
// and nothing ever queries this table tenant-scoped and directly.
model CalendarEventOccurrence {
  id Int @id @default(autoincrement())

  eventId Int
  event   CalendarEvent @relation(fields: [eventId], references: [id])

  // WHICH occurrence this overrides: its original computed start.
  originalStartsAt DateTime

  cancelled Boolean @default(false)

  // Overrides. NULL = inherit from the series.
  startsAt DateTime?
  endsAt   DateTime?
  title    String?
  location String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One exception per occurrence. New/empty table, so a constraint is fine.
  @@unique([eventId, originalStartsAt])
}

// Attendees. Table created here; invitations and RSVP are CAL2.1 — nothing
// writes this in CAL1.
model CalendarParticipant {
  id Int @id @default(autoincrement())

  eventId Int
  event   CalendarEvent @relation(fields: [eventId], references: [id])

  // Scalar — an attendance record outlives the account that held it.
  userId Int?

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // External attendee with no account.
  email String?

  // PARTICIPANT_RESPONSES.
  response    String  @default("needs_action")
  isOrganizer Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per user per event. PostgreSQL treats NULLs as distinct, so this
  // deliberately does NOT restrict external (email-only) attendees, of which an
  // event may have many.
  //
  // This also serves every "the participants of event X" lookup through its
  // leftmost prefix, so there is deliberately NO separate @@index([eventId]) —
  // it would be a second index on the same leading column, paid for on every
  // insert and never chosen over this one. Scope §7.2 listed both; dropped here
  // for the reason ProjectAssignment already documents in this schema.
  @@unique([eventId, userId])
  // employeeId gets its own index because NOTHING else covers it: it is the one
  // foreign key in this module with no index of its own and no unique whose
  // leading column it is. Without it, deleting an Employee sequentially scans
  // this table to apply ON DELETE SET NULL. Harmless while the table is empty
  // (CAL2.1 fills it), which is precisely why it is cheap to get right now —
  // the repo indexes its other employee foreign keys the same way
  // (Task.employeeId, OwnerNote.employeeId).
  @@index([employeeId])
}

// Files on an event. Mirrors ProjectAttachment field-for-field so the existing
// services/storage signed-URL path is reused unchanged — a second upload route
// would bypass the R1.5 signed-upload guard. API is CAL2.4.
model CalendarEventAttachment {
  id Int @id @default(autoincrement())

  eventId Int
  event   CalendarEvent @relation(fields: [eventId], references: [id])

  // Scalar, matching this model's siblings.
  userId Int

  fileName String
  fileType String
  fileSize Int
  fileUrl  String

  // Free-form, same rationale as ProjectAttachment.category.
  category String @default("Other")

  createdAt DateTime @default(now())

  @@index([eventId])
}

// Append-only — hence NO updatedAt, per the schema convention.
// API is CAL2.4.
model CalendarEventComment {
  id Int @id @default(autoincrement())

  eventId Int
  event   CalendarEvent @relation(fields: [eventId], references: [id])

  userId Int

  content String

  createdAt DateTime @default(now())

  @@index([eventId])
}

// Per-user reminder offsets. The sweep that acts on these is CAL2.3; this must
// not become a second Reminder model that only ever stores and never delivers
// (plan §1.1).
model CalendarEventReminder {
  id Int @id @default(autoincrement())

  eventId Int
  event   CalendarEvent @relation(fields: [eventId], references: [id])

  // NULL = applies to everyone on the event.
  userId Int?

  minutesBefore Int

  // NOTIFICATION_CHANNELS vocabulary, reused rather than redefined.
  channel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// D13 — the audit trail. Polymorphic (targetType + targetId, the
// OwnerNoteConversion pattern) because a permission change happens on the
// Calendar or the CalendarMember, not on an event: a table keyed on eventId
// could not have recorded the single most security-relevant thing that
// happens in this module.
//
// Two properties this table depends on, both of which CAL1.1 tests pin:
//
//   * targetId carries NO foreign key. That is what lets the audit row for a
//     deleted event survive the event — answering "who created the thing that
//     was later removed?", which is the question the log exists for.
//   * actorUserId is a SCALAR. The row survives the actor's account deletion.
//
// companyId IS carried here, unlike the other child tables above, for exactly
// that reason: the row must remain tenant-attributable after the event it
// describes is gone, so the parent is not a reliable route to the tenant.
//
// Written in the SAME TRANSACTION as the mutation it records (CAL1.4+) — a
// deliberate departure from logAudit()'s fire-and-forget contract. If the audit
// write fails, the mutation rolls back. The cost is stated plainly: a problem
// with this table stops calendar writes. For a log whose purpose is answering
// security questions, silent holes are worse, because nobody can tell where
// they are.
//
// Append-only — no updatedAt.
model CalendarAudit {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  // Always set, including for member and participant changes — this is what
  // makes "what happened on this calendar?" a single query.
  calendarId Int
  calendar   Calendar @relation(fields: [calendarId], references: [id])

  // AUDIT_TARGET_TYPES: CALENDAR | EVENT | MEMBER | PARTICIPANT.
  targetType String

  // Deliberately NOT a foreign key — see the header.
  targetId Int

  // CALENDAR_AUDIT_ACTIONS.
  action String

  // Scalar. NULL = the system acted, not a person.
  actorUserId Int?

  // AUDIT_SOURCES: WEB | API | SYSTEM. Derived server-side from the
  // authentication path, NEVER read from a header or request body — a
  // client-settable source would make the table lie about the very field an
  // investigation starts from.
  source String

  // req.id (app.ts) — ties every audit row produced by one request together.
  requestId String?

  // JSON string: { field: { from, to } }. Changed fields only, never a whole
  // row snapshot — a snapshot would copy private events' titles into the log on
  // every edit and grow it to a multiple of the real content.
  changes String?

  createdAt DateTime @default(now())

  // The per-calendar timeline (CAL2.6's reader).
  @@index([calendarId, createdAt])
  @@index([companyId, createdAt])
  // "What happened to this specific event/member?"
  @@index([targetType, targetId])
  @@index([actorUserId])
}
