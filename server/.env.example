# Axeriva backend environment — copy to server/.env and fill in.
# Validation: DATABASE_URL and JWT_SECRET are required in every environment;
# with NODE_ENV=production ALL variables marked (prod: required) must be set
# or the server exits at startup. See docs/environment.md.

# "development" (default) or "production"
NODE_ENV="development"

# API port (default: 5000)
PORT=5000

# PostgreSQL connection string (Prisma datasource). Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local dev example:
#   postgresql://postgres:postgres@localhost:5432/axeriva?schema=public
# Managed/hosted providers usually require TLS — append `&sslmode=require`.
# NOTE: this replaced the previous SQLite file URL (`file:./axeriva.db`); a
# `file:` URL is no longer valid and the server will fail to connect.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/axeriva?schema=public"

# Long random string used to sign JWTs — required everywhere.
JWT_SECRET="change-me-to-a-long-random-secret"

# Frontend origin — used for CORS and for links in emails / Stripe redirects.
# (prod: required) Unset locally = allow-all CORS + http://localhost:5173 links.
APP_URL="http://localhost:5173"

# Absolute path to a persistent disk mount for uploaded project attachments
# (see middleware/upload.middleware.ts). (prod: required) Leave unset locally;
# defaults to ./uploads under the server working directory.
# UPLOAD_ROOT="/var/data/uploads"

# Stripe — (prod: required). Leave unset locally to disable billing routes
# (they fail with a clear error instead of silently using a fake key).
# STRIPE_SECRET_KEY selects Test vs Live (sk_test_… / sk_live_…); the price
# IDs below must come from the same account. The mode is verified at startup
# (config/stripeKeyMode.ts): a test key under NODE_ENV=production is fatal.
STRIPE_SECRET_KEY=""
# Staging-only escape hatch: production NODE_ENV + sk_test_ key would normally
# refuse to start (see config/stripeKeyMode.ts). Set to "true" ONLY on a
# deliberate staging deploy — never on the live one.
# ALLOW_TEST_STRIPE_KEY="true"
# Legacy single price ("Axeriva Pro") — kept for backward compatibility with
# existing subscriptions and the legacy checkout path.
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Commercial plan prices (S2.3) — per plan, per currency. (prod: required —
# startup fails fast if any are missing.) Leave unset locally until you've run
# `npm run stripe:setup`, which creates the products/prices and prints these
# lines. Enterprise has no price (Contact Sales, outside the Stripe catalog
# entirely); Founder is internal-only and never has a Stripe product.
STRIPE_PRICE_STARTER_EUR=""
STRIPE_PRICE_STARTER_HUF=""
STRIPE_PRICE_PROFESSIONAL_EUR=""
STRIPE_PRICE_PROFESSIONAL_HUF=""
STRIPE_PRICE_BUSINESS_EUR=""
STRIPE_PRICE_BUSINESS_HUF=""

# Currently UNUSED by the code (no frontend Stripe.js integration yet) —
# kept only as a placeholder for a future client-side Stripe integration.
STRIPE_PUBLISHABLE_KEY=""

# Resend (email) — (prod: required). Leave RESEND_API_KEY unset locally to
# use MockEmailService (emails are logged to the console, not sent).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Axeriva <noreply@axeriva.com>"

# Used only by `npm run seed:developer` when no CLI args are given.
# DEVELOPER_EMAIL="admin@example.com"
# DEVELOPER_PASSWORD="change-me"
